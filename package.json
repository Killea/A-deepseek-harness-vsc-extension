{
  "name": "dsh-vsc",
  "displayName": "DeepSeek Harness",
  "description": "DeepSeek Harness for VS Code",
  "version": "0.1.1",
  "publisher": "weinibuliu",
    "repository": {
    "type": "git",
    "url": "https://github.com/weinibuliu/deepseek-harness-vsc-extension"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI","Chat"
  ],
  "main": "./dist/extension.js",
  "icon": "ui/favicon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "weinibuliu-dsh-vsc",
          "title": "DeepSeek Harness",
          "icon": "ui/favicon.svg"
        }
      ]
    },
    "views": {
      "weinibuliu-dsh-vsc": [
        {
          "icon":"ui/favicon.svg",
          "type": "webview",
          "id": "weinibuliu-dsh-vsc.chat",
          "name": "Chat",
          "contextualTitle": "dsh Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "weinibuliu.dsh-vsc.focus",
        "title": "dsh: Open Chat"
      },
      {
        "command": "weinibuliu.dsh-vsc.openInBrowser",
        "title": "dsh: Open Web UI in Browser"
      },
      {
        "command": "weinibuliu.dsh-vsc.newSession",
        "title": "dsh: New Session"
      },
      {
        "command": "weinibuliu.dsh-vsc.refreshSessions",
        "title": "dsh: Refresh Sessions"
      }
    ],
    "configuration": {
      "title": "DeepSeekHarness",
      "properties": {
        "weinibuliu.dsh-vsc.dshPath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Explicit path to the dsh executable. Empty: discover via PATH, npm global prefix, then npx --no-install."
        },
        "weinibuliu.dsh-vsc.minDshVersion": {
          "type": "string",
          "default": "0.1.0-rc.6",
          "description": "Minimum accepted dsh version (semver, prerelease-aware)."
        },
        "weinibuliu.dsh-vsc.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Spawn the dsh web server when a workspace window opens."
        }
      }
    }
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "pnpm run build:webview && node esbuild.mjs",
    "build:webview": "vite build",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm build && vsce package"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.0.5",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
